  - id: 886834fe-ae21-454a-b825-8bb57d5c55d9
    type: script
    props:
      interpreter: zsh
      outputVariable: release_notes
      name: 获取发布说明
      code: "gh release view {{ var.release }} --json body | jq -r .body "
      outputVisible: false
      dependency: "{}"
    children: []
