        styles: {}
    children: []
  - id: 513b2ab6-5977-4b2f-8adc-37fb518f7925
    type: paragraph
    props:
      textColor: default
      backgroundColor: default
      textAlignment: left
    content:
      - type: text
        text: 本示例演示如何使用由命令输出填充的下拉块（点击下拉块左侧的按钮可查看命令）。选中的发布版本随后由脚本块用于获取发布说明，并将内容填充到编辑器块中。
        styles: {}
    children: []
  - id: 8a6fe381-5810-42ed-a20e-d3682352253e
    type: paragraph
    props:
