name: 获取发布说明
version: 1
content:
  - id: f6596d68-4414-48f3-b502-eb54c9a00b17
    type: heading
    props:
      textColor: default
      backgroundColor: default
      textAlignment: left
      level: 1
      isToggleable: false
    content:
