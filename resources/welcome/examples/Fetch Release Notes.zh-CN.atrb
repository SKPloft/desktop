  - id: e4ad84fd-ed24-45eb-8dae-5a68d31a55dd
    type: dropdown
    props:
      name: 发布版本
      options: gh release list --json name,tagName --jq '.[] | .name + ":" + .tagName'
      fixedOptions: ""
      variableOptions: ""
      commandOptions: gh release list --json name,tagName --jq '.[] | .name + ":" + .tagName'
      value: v0.0.106
      optionsType: command
      interpreter: bash
    children: []
  - id: 493536c0-c6a2-47d1-bfd8-b0ebd045c40a
    type: paragraph
